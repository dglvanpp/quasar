<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_oled">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/contenedorCampos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <include
            android:id="@+id/tecladoMatematico"
            layout="@layout/layout_teclado_matematico" />

        <Button
            android:id="@+id/btnResolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Resolver" />

        <!-- Contenedor dinámico de resultados tradicionales -->
        <LinearLayout
            android:id="@+id/contenedorResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp" />

        <!-- Visor MathJax para ecuaciones renderizadas nivel profesional -->
        <WebView
            android:id="@+id/visorMatematico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#000000" />

    </LinearLayout>
</ScrollView>