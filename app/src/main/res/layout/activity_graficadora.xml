<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Ecuaciones"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="f(x) =" />
    <EditText
        android:id="@+id/etFuncion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ej. x**2 - 3*x + 2  |  sin(x)  |  1/x" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/etXMin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="x mínimo"
            android:inputType="numberSigned|numberDecimal" />

        <EditText
            android:id="@+id/etXMax"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="x máximo"
            android:inputType="numberSigned|numberDecimal" />
    </LinearLayout>

    <Button
        android:id="@+id/btnGraficar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Graficar" />

    <TextView
        android:id="@+id/tvErrorGrafica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D32F2F" />

    <com.tutor.cecyt3.GraphView
        android:id="@+id/graphView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#FAFAFA" />

</LinearLayout>
