<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".GraficadoraActivity" android:exported="false" android:label="Panel de Ecuaciones"/>
        <activity android:name=".MateriaActivity" android:exported="false"/>
        <activity android:name=".FormularioActivity" android:exported="false"/>
    </application>
</manifest>